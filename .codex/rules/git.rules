prefix_rule(
    pattern = [
        "git",
        [
            "status",
            "diff",
            "log",
            "show",
            "add",
            "commit",
        ],
    ],
    decision = "allow",
    justification = "Permit routine Git operations in this trusted repository",
    match = [
        "git status --short --branch",
        "git diff --stat",
        "git log -5 --oneline",
        "git show HEAD",
        "git add README.md",
        "git commit -m 'docs: update README'",
    ],
    not_match = [
        "git push origin main",
        "git reset --hard HEAD",
        "git clean -fd",
    ],
)
